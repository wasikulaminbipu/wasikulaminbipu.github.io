{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Portfolio website of DR. Wasikul Amin Bipu, DVM(BSMRAU). This website takes all the information you need in one place.",
  "main": "index.js",
  "scripts": {
    "watch:sass": "sass --silence-deprecation=import,global-builtin,color-functions,if-function --watch src/scss:_site/styles",
    "build:sass": "sass --style=compressed --silence-deprecation=import,global-builtin,color-functions,if-function src/scss:_site/styles",
    "watch:eleventy": "eleventy --serve",
    "build:eleventy": "eleventy",
    "start": "npm-run-all build:sass --parallel watch:*",
    "build": "npm-run-all build:*"
  },
  "keywords": [
    "Portfolio",
    "Bipu",
    "DR. Bipu",
    "Vet. Bipu",
    "DR. Wasikul Amin Bipu",
    "Data Analyst",
    "R Programmer",
    "BD Data Analyst"
  ],
  "author": "Wasikul Amin Bipu",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "html-minifier-terser": "^7.2.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.102.0"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^7.0.0",
    "bootstrap": "^5.3.8",
    "eleventy-plugin-svg-contents": "^0.7.0"
  }
}
