{% macro skills_section(skills_data) %}
<section class="resume-section" id="skills">
    <div class="resume-section-content">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
            <h2 class="mb-3 mb-md-0">Skills & Tools</h2>
            <!-- Filter Pills -->
            <div class="btn-group flex-wrap gap-2" id="skillFilterGroup" role="group" aria-label="Filter skills">
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill active" data-filter="all">All</button>
                {% for skill in skills_data %}
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" data-filter="{{ skill.skill_name | slugify }}">{{ skill.skill_name }}</button>
                {% endfor %}
            </div>
        </div>

        {% for skill in skills_data %}
            <div class="skill-category-block mb-4" data-category="{{ skill.skill_name | slugify }}">
                <h4 class="text-start mb-3 text-secondary border-bottom pb-2"><i class="fa-solid fa-layer-group text-primary me-2"></i> {{ skill.skill_name }}</h4>
                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3 mb-4">
                {% for skill_item in skill.list %}
                    <div class="col skill-card-col">
                        <div class="glass-card h-100 p-3 text-center d-flex flex-column align-items-center justify-content-center">
                            <img class="mb-2 img-fluid" width="44" height="44" loading="lazy" decoding="async" style="height: 44px; width: auto; object-fit: contain; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.08)); transition: transform 0.3s ease;" alt="{{ skill_item.title }}" src="{{ "/assets/skills/" + skill_item.icon_link | url }}">
                            <span class="fw-semibold text-dark small mt-1">{{ skill_item.title }}</span>
                        </div>
                    </div>
                {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</section>
<hr class="m-0">
{% endmacro %}

