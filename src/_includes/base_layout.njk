<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        (function() {
            var theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="author" content="DR. Wasikul Amin Bipu">
    <meta name="keywords" content="Portfolio, pfolio, dr bipu, wasikul amin bipu, Veterinarian, Data Analyst, R Programmer, DVM, BSMRAU">
    <meta name="description" content="Official portfolio website of DR. Wasikul Amin Bipu - DVM (BSMRAU), Data Analyst, and R Programmer.">
    <link rel="canonical" href="https://wasikulaminbipu.github.io/">
    <title>{{ title | default("DR. Wasikul Amin Bipu | Veterinarian & Data Analyst Portfolio") }}</title>

    <!-- OpenGraph SEO -->
    <meta property="og:title" content="{{ title | default("DR. Wasikul Amin Bipu | Veterinarian & Data Analyst Portfolio") }}">
    <meta property="og:description" content="Official portfolio website of DR. Wasikul Amin Bipu, DVM (BSMRAU), Data Analyst & R Programmer.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://wasikulaminbipu.github.io/">
    <meta property="og:image" content="https://wasikulaminbipu.github.io/assets/profile.jpg">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title | default("DR. Wasikul Amin Bipu | Veterinarian & Data Analyst Portfolio") }}">
    <meta name="twitter:description" content="Official portfolio website of DR. Wasikul Amin Bipu, DVM (BSMRAU), Data Analyst & R Programmer.">
    <meta name="twitter:image" content="https://wasikulaminbipu.github.io/assets/profile.jpg">

    <!-- Preconnect & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Inter:wght@400;500;600;700&family=Saira+Extra+Condensed:wght@500;700&display=swap">
    <link rel="stylesheet" href="styles/styles.css">
    
    <!-- FontAwesome CSS (Lightweight non-blocking) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Structured Data (JSON-LD Schema.org) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "DR. Wasikul Amin Bipu",
      "jobTitle": "Veterinarian & Data Analyst",
      "url": "https://wasikulaminbipu.github.io/",
      "almaMater": {
        "@type": "CollegeOrUniversity",
        "name": "Bangabandhu Sheikh Mujibur Rahman Agricultural University (BSMRAU)"
      },
      "knowsAbout": [
        "Veterinary Medicine",
        "Data Analysis",
        "R Programming",
        "Data Visualization",
        "R Shiny & Flex-Dashboard",
        "Clinical Research",
        "Systematic Review & Meta-Analysis",
        "Flutter App Development"
      ]
    }
    </script>
</head>
<body id="page-top">
    {% include "navigation.njk" %}
    
    {% from "about_section.njk" import aboutSection %}
    {{ aboutSection(about | default(about_section), socials | default(social_links)) }}

    {% from "education_section.njk" import eduSection %}
    {{ eduSection(education | default(education_section)) }}

    {% from "certifications_section.njk" import certificationsSection %}
    {{ certificationsSection(certifications | default(certifications_section)) }}

    {% from "skills_section.njk" import skills_section %}
    {{ skills_section(skills) }}

    {% from "contact_section.njk" import contactSection %}
    {{ contactSection(about | default(about_section)) }}

    <!-- Client-side Interactive Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="{{ '/assets/js/main.js' | url }}" defer></script>
</body>
</html>