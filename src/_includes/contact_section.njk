{% macro contactSection(about_data) %}
<section class="resume-section" id="contact">
    <div class="resume-section-content">
        <h2 class="mb-2">Contact <span class="text-primary">&amp; Inquiries</span></h2>
        <p class="lead mb-4 text-muted">Have a research query, data analysis project, or veterinary collaboration in mind? Send a message directly.</p>

        <div class="row g-4">
            <!-- Contact Info Column -->
            <div class="col-lg-5">
                <div class="contact-card h-100 d-flex flex-column justify-content-between">
                    <div>
                        <h4 class="mb-4 text-primary fw-bold"><i class="fa-solid fa-address-card me-2"></i> Get in Touch</h4>
                        
                        <div class="d-flex align-items-center mb-4">
                            <div class="contact-info-icon me-3">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block uppercase fw-bold">Email Address</small>
                                <a href="mailto:{{ about_data.email }}" class="text-decoration-none fw-semibold text-body">{{ about_data.email }}</a>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-4">
                            <div class="contact-info-icon me-3">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block uppercase fw-bold">Location</small>
                                <span class="fw-semibold text-body">{{ about_data.address }}</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-4">
                            <div class="contact-info-icon me-3">
                                <i class="fa-solid fa-phone"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block uppercase fw-bold">Mobile / Phone</small>
                                <a href="tel:{{ about_data.mobile }}" class="text-decoration-none fw-semibold text-body">{{ about_data.mobile }}</a>
                            </div>
                        </div>
                    </div>

                    <div class="pt-3 border-top">
                        <small class="text-muted d-block mb-2 fw-semibold">Connect on Social Platforms:</small>
                        <div class="social-icons">
                            <a href="https://linkedin.com/in/wasikulaminbipu" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                            <a href="https://github.com/wasikulaminbipu" target="_blank" rel="noopener" aria-label="GitHub"><i class="fab fa-github"></i></a>
                            <a href="https://orcid.org/0009-0001-4141-9954" target="_blank" rel="noopener" aria-label="ORCID"><i class="fab fa-orcid"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Column -->
            <div class="col-lg-7">
                <div class="contact-card">
                    <h4 class="mb-3 fw-bold"><i class="fa-solid fa-paper-plane me-2 text-primary"></i> Send a Direct Message</h4>
                    <form id="contactForm" class="needs-validation" novalidate>
                        <!-- FormSubmit Configuration -->
                        <input type="hidden" name="_subject" value="New Portfolio Contact Message - DR. Wasikul Amin Bipu">
                        <input type="hidden" name="_captcha" value="false">
                        <input type="text" name="_honey" style="display:none">

                        <div class="mb-3">
                            <label for="contactName" class="form-label fw-semibold">Your Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="contactName" name="name" placeholder="Dr. Jane Doe" required>
                            <div class="invalid-feedback">Please enter your name.</div>
                        </div>

                        <div class="mb-3">
                            <label for="contactEmail" class="form-label fw-semibold">Your Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="contactEmail" name="email" placeholder="jane@example.com" required>
                            <div class="invalid-feedback">Please enter a valid email address.</div>
                        </div>

                        <div class="mb-3">
                            <label for="contactSubject" class="form-label fw-semibold">Subject</label>
                            <input type="text" class="form-control" id="contactSubject" name="subject" placeholder="Data Analysis Collaboration / Consultation">
                        </div>

                        <div class="mb-3">
                            <label for="contactMessage" class="form-label fw-semibold">Message <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="contactMessage" name="message" rows="4" placeholder="Hello Dr. Bipu, I would like to discuss..." required></textarea>
                            <div class="invalid-feedback">Please enter your message.</div>
                        </div>

                        <button type="submit" id="contactSubmitBtn" class="btn btn-primary px-4 py-2 fw-bold text-uppercase">
                            <i class="fa-solid fa-paper-plane me-2"></i> Send Message
                        </button>

                        <div id="formStatus" class="d-none"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<hr class="m-0">
{% endmacro %}
