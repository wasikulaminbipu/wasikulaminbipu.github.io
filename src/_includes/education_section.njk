{% macro eduSection(edu_data) %}
<section class="resume-section" id="education">
    <div class="resume-section-content">
        <h2 class="mb-5">Education</h2>
        <div class="d-flex flex-column gap-4">
        {% set eduList = edu_data.institutional_educations or edu_data %}
        {% for item in eduList %}
            <div class="glass-card p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between">
                    <div class="flex-grow-1">
                        <h3 class="mb-1 text-primary">{{ item.institution_or_board }}</h3>
                        <div class="subheading mb-2 text-body fw-bold">{{ item.degree_name }}</div>
                        <div class="text-secondary mb-2"><i class="fa-solid fa-book-open me-1"></i> {{ item.subject_or_group }}</div>
                        <span class="badge bg-light text-dark border"><i class="fa-solid fa-award me-1 text-primary"></i> {{ item.result_type + ": " + item.point }}</span>
                    </div>
                    <div class="flex-shrink-0 mt-3 mt-md-0">
                        <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill"><i class="fa-regular fa-calendar-alt me-1"></i> {{ item.duration_or_passingyear }}</span>
                    </div>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</section>
<hr class="m-0">
{% endmacro %}
