{% macro aboutSection(about_data, social_links) %}
<section class="resume-section" id="about">
    <div class="resume-section-content">
        <div class="mb-3">
            <span class="role-badge"><i class="fa-solid fa-user-doctor me-1"></i> Veterinarian (DVM)</span>
            <span class="role-badge"><i class="fa-solid fa-chart-line me-1"></i> Data Analyst</span>
            <span class="role-badge"><i class="fa-solid fa-code me-1"></i> R Programmer</span>
        </div>
        <h1 class="mb-2"><span class="text-secondary">{{ about_data.name_prefix }}</span> {{ about_data.first_name }} <span class="text-primary">{{ about_data.last_name }}</span></h1>
        <div class="subheading mb-4 d-flex flex-wrap align-items-center gap-2 text-muted fs-6">
            <span class="d-inline-flex align-items-center me-3"><i class="fa-solid fa-location-dot text-primary me-1"></i> {{ about_data.address }}</span>
            <span class="d-inline-flex align-items-center me-3"><i class="fa-solid fa-phone text-primary me-1"></i> {{ about_data.mobile }}</span>
            <a href={{"mailto:" + about_data.email}} class="text-decoration-none d-inline-flex align-items-center"><i class="fa-solid fa-envelope text-primary me-1"></i> {{ about_data.email | safe }}</a>
        </div>
        <p class="lead mb-4">{{ about_data.about | safe }}</p>
        
        <div class="d-flex flex-wrap align-items-center gap-3 mb-5">
            <a href="#contact" class="btn btn-primary px-4 py-2 fw-bold text-uppercase shadow-sm">
                <i class="fa-solid fa-paper-plane me-2"></i> Get in Touch
            </a>
            <a href="mailto:wasikulaminbipu@gmail.com?subject=Resume Request" class="btn btn-outline-primary px-4 py-2 fw-bold text-uppercase">
                <i class="fa-solid fa-file-arrow-down me-2"></i> Request / Download CV
            </a>
        </div>

        <div class="social-icons">
            {% from "macro/social_item.njk" import socialItem %}
            {{ socialItem("fa-linkedin", social_links.linkedin) }}
            {{ socialItem("fa-github", social_links.github) }}
            {{ socialItem("fa-twitter", social_links.twitter) }}
            {{ socialItem("fa-facebook-f", social_links.facebook) }}
            {{ socialItem("fa-orcid", social_links.orcid) }}
            {{ socialItem("fa-whatsapp", social_links.whatsapp) }}
        </div>
    </div>
</section>
<hr class="m-0">
{% endmacro %}
